PORT=5000

# Anthropic Claude API (for OCR/field extraction from handwritten waybill)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GSP (GST Suvidha Provider) - Adaequare credentials
GSP_BASE_URL=https://gsp.adaequare.com
GSP_APP_ID=your_gsp_app_id
GSP_APP_SECRET=your_gsp_app_secret
GSP_USERNAME=your_gstin_username
GSP_PASSWORD=your_gstin_password
GSTIN=your_gstin_number

# "sandbox" = test environment | "production" = live NIC portal
GSP_MODE=sandbox

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Super Admin password (used on first run to create the super_admin account)
ADMIN_PASSWORD=your_admin_password

# JWT secret — REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# AES-256 encryption key for NIC credentials — REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPT_SECRET=your_encrypt_secret_here
